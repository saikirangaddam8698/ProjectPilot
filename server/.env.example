# ProjectPilot Server Environment Configuration Template
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
API_PREFIX=/api/v1

# PostgreSQL Database Configuration (Prisma)
# Connection pooling and timeout settings:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectpilot?schema=public&connection_limit=10&pool_timeout=10"

# Authentication & Session Secrets
JWT_SECRET=projectpilot-dev-jwt-super-secret-key-32-chars-minimum
JWT_EXPIRES_IN=1h

# Initial Production Administrator Bootstrap (Used ONLY by npm run db:bootstrap-admin)
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
INITIAL_ADMIN_PASSWORD=YourSecureProductionPassword123!

# Frontend Client Demo Accounts Flag (Set to false in Production)
VITE_ENABLE_DEMO_ACCOUNTS=true

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info
