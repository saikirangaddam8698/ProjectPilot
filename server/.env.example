# ProjectPilot Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
API_PREFIX=/api/v1

# PostgreSQL Database Configuration (Prisma)
# Connection pooling and timeout settings are configured via URL parameters:
# - connection_limit: maximum number of active database connections (default 10)
# - pool_timeout: timeout in seconds to wait for a connection before failing (default 10)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectpilot?schema=public&connection_limit=10&pool_timeout=10"

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
