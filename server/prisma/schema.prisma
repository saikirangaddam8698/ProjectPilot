// ProjectPilot Prisma Database Schema
// PostgreSQL Persistent Database Layer

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  PLANNING
  COMPLETED
  ARCHIVED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  TASK
  BUG
  STORY
  EPIC
}

enum MemberStatus {
  ACTIVE
  AWAY
  OFFLINE
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(DEVELOPER)
  memberId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 1-to-1 relationship with Member profile
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([role])
}

model Member {
  id          String       @id
  name        String
  avatar      String
  email       String       @unique
  role        String
  department  String
  status      MemberStatus @default(ACTIVE)
  skills      String[]     @default([])
  capacity    Int          @default(20)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  user               User?
  projectMemberships ProjectMember[]
  ledProjects        Project[]       @relation("ProjectLead")
  assignedTickets    Ticket[]        @relation("TicketAssignee")
  reportedTickets    Ticket[]        @relation("TicketReporter")
  activities         Activity[]      @relation("ActivityActor")

  @@index([email])
  @@index([status])
}

model Project {
  id          String        @id
  key         String        @unique
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  leadId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relationships
  lead        Member?         @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  members     ProjectMember[]
  tickets     Ticket[]
  sprints     Sprint[]
  activities  Activity[]

  @@index([key])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  memberId  String
  role      String?
  joinedAt  DateTime @default(now())

  // Relationships
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
}

model Sprint {
  id          String       @id
  projectId   String
  name        String
  goal        String?      @db.Text
  status      SprintStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completedAt DateTime?

  // Relationships
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
}

model Ticket {
  id          String         @id
  key         String         @unique
  projectId   String
  title       String
  description String?        @db.Text
  type        TicketType     @default(TASK)
  status      TicketStatus   @default(TODO)
  priority    TicketPriority @default(MEDIUM)
  assigneeId  String?
  reporterId  String?
  sprintId    String?
  storyPoints Int            @default(0)
  rank        Int            @default(100)
  labels      String[]       @default([])
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relationships
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    Member?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    Member?        @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  sprint      Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([rank])
}

model Activity {
  id          String   @id
  projectId   String
  actorId     String?
  type        String
  action      String
  targetType  String
  targetId    String?
  targetKey   String?
  targetTitle String?
  message     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relationships
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       Member?  @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([actorId])
  @@index([createdAt])
}
