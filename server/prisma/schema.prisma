// ProjectPilot Prisma Database Schema
// PostgreSQL Persistent Database Layer

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  QA
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  PLANNING
  COMPLETED
  ARCHIVED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  REOPENED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  TASK
  BUG
  STORY
  EPIC
}

enum MemberStatus {
  ACTIVE
  AWAY
  OFFLINE
}

enum DocumentType {
  ARCHITECTURE
  API_SPEC
  RUNBOOK
  REQUIREMENTS
  TROUBLESHOOTING
  GENERAL
}

enum DocumentStatus {
  DRAFT
  INDEXED
  OUTDATED
  PROCESSING
  READY
  FAILED
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_REOPENED
  USER_MENTIONED
  COMMENT_ADDED
  SPRINT_STARTED
  SPRINT_COMPLETED
  STATUS_CHANGED
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         Role           @default(DEVELOPER)
  memberId     String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // 1-to-1 relationship with Member profile
  member       Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([email])
  @@index([role])
}

model Member {
  id          String       @id
  name        String
  avatar      String
  email       String       @unique
  role        String
  department  String
  status      MemberStatus @default(ACTIVE)
  skills      String[]     @default([])
  capacity    Int          @default(20)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  user               User?
  projectMemberships ProjectMember[]
  ledProjects        Project[]       @relation("ProjectLead")
  assignedTickets    Ticket[]        @relation("TicketAssignee")
  reportedTickets    Ticket[]        @relation("TicketReporter")
  activities         Activity[]      @relation("ActivityActor")
  authoredDocs       Document[]      @relation("DocumentAuthor")
  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications     Notification[] @relation("NotificationActor")

  @@index([email])
  @@index([status])
}

model Project {
  id          String        @id
  key         String        @unique
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(ACTIVE)
  leadId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relationships
  lead          Member?         @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  tickets       Ticket[]
  sprints       Sprint[]
  activities    Activity[]
  documents     Document[]
  conversations Conversation[]

  @@index([key])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  memberId  String
  role      String?
  joinedAt  DateTime @default(now())

  // Relationships
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@index([projectId])
  @@index([memberId])
}

model Sprint {
  id          String       @id
  projectId   String
  name        String
  goal        String?      @db.Text
  status      SprintStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  capacity    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completedAt DateTime?

  // Relationships
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
}

model Ticket {
  id          String         @id
  key         String         @unique
  projectId   String
  title       String
  description String?        @db.Text
  type        TicketType     @default(TASK)
  status      TicketStatus   @default(TODO)
  priority    TicketPriority @default(MEDIUM)
  assigneeId  String?
  reporterId  String?
  sprintId    String?
  storyPoints Int            @default(0)
  rank        Int            @default(100)
  labels      String[]       @default([])
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relationships
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    Member?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    Member?        @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  sprint      Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([rank])
}

model Activity {
  id          String   @id
  projectId   String
  actorId     String?
  type        String
  action      String
  targetType  String
  targetId    String?
  targetKey   String?
  targetTitle String?
  message     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relationships
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       Member?  @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([actorId])
  @@index([createdAt])
}

model Document {
  id           String         @id @default(cuid())
  projectId    String
  title        String
  fileName     String?
  mimeType     String?
  fileSize     Int?
  checksum     String?
  description  String?        @db.Text
  documentType DocumentType   @default(GENERAL)
  source       String?        @default("manual")
  content      String         @db.Text
  status       DocumentStatus @default(DRAFT)
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relationships
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy Member?         @relation("DocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  chunks    DocumentChunk[]

  @@index([projectId])
  @@index([status])
  @@index([documentType])
  @@index([createdAt])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  projectId  String?
  chunkIndex Int
  content    String                      @db.Text
  tokenCount Int                         @default(0)
  metadata   Json?                       // page, section, source
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  // Relationships
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([chunkIndex])
  @@index([projectId])
}

model Conversation {
  id          String                @id @default(cuid())
  projectId   String
  createdById String?
  title       String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  // Relationships
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  messages    ConversationMessage[]

  @@index([projectId])
  @@index([createdById])
  @@index([createdAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // "user" or "assistant"
  content        String       @db.Text
  metadata       Json?        // executedTools, sources, analysis, grounded, agentRounds, requestId, usage, model
  createdAt      DateTime     @default(now())

  // Relationships
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String?
  recipientId String
  actorId     String?
  projectId   String?
  type        NotificationType
  title       String
  message     String           @db.Text
  link        String?
  read        Boolean          @default(false)
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  recipient   Member           @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       Member?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([recipientId, read])
  @@index([createdAt])
}

