# ProjectPilot Environment Variable Configuration Template
# Duplicate this file to .env for local development or production deployment

# Application Settings
NODE_ENV=production
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database Configuration (Neon PostgreSQL Cloud Instance)
DATABASE_URL=postgresql://user:password@ep-host.neon.tech/dbname?sslmode=require

# Authentication Secrets (Generate 32+ char secure secret for production)
JWT_SECRET=production-super-secret-jwt-key-minimum-32-characters-required
JWT_EXPIRES_IN=1h

# Initial Production Administrator Bootstrap (Used ONLY by npm run db:bootstrap-admin)
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
INITIAL_ADMIN_PASSWORD=YourSecureProductionPassword123!

# Frontend Client Demo Accounts Flag (Set to false in Production)
VITE_ENABLE_DEMO_ACCOUNTS=true

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google Gemini AI Service Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# AI Production Hardening Thresholds
GEMINI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_RETRY_DELAY_MS=200
AGENT_EXECUTION_TIMEOUT_MS=30000
AI_MAX_TOTAL_TOOL_CALLS=10
AI_MAX_CONTEXT_CHARACTERS=24000
AI_MAX_CONCURRENT_REQUESTS=10
